APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
BIND_ADDRESS=127.0.0.1
HOST_PORT=8010
UPLOAD_DIR=/tmp/ai-toolbox/uploads
RESULT_DIR=/tmp/ai-toolbox/results
MAX_UPLOAD_MB=100
UPLOAD_RETENTION_HOURS=24
RESULT_RETENTION_HOURS=24
CLEANUP_INTERVAL_MINUTES=60
YOUTUBE_MAX_DOWNLOAD_MB=500
YOUTUBE_MAX_DURATION_SECONDS=7200
# 비우면 직접 연결. VPS에서는 가정용 회선 프록시 사용 (DEPLOYMENT.md 11절)
YOUTUBE_PROXY=
# 이미지 생성 (TASKS.md Phase 3). 비워 두면 해당 기능이 원인을 안내하는 오류를 낸다
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# Windows ComfyUI의 Tailscale 주소, 예: http://<windows-tailscale-ip>:8188 (DEPLOYMENT.md 12절)
COMFYUI_URL=
COMFYUI_TIMEOUT_SECONDS=300
NPM_NETWORK=nginx-proxy-manager_default
CONTAINER_CPU_LIMIT=2.0
CONTAINER_MEMORY_LIMIT=2g
